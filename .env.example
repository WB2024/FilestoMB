# Copy this file to .env and fill in your details.

# --- MusicBrainz (required) ----------------------------------------------------
# MusicBrainz requires every API client to send a descriptive User-Agent with
# real contact info: "APP_NAME/APP_VERSION ( CONTACT )". There is no API key.
MB_APP_NAME=FilesToMB
MB_APP_VERSION=1.0.0
MB_CONTACT=you@example.com

# Only to point at a different MusicBrainz-compatible server (e.g. the beta site).
MB_API_BASE_URL=https://musicbrainz.org/ws/2

# Optional: log in to MusicBrainz from the app (for collections). Register an
# "Installed application" at https://musicbrainz.org/account/applications and
# leave its redirect URI exactly as urn:ietf:wg:oauth:2.0:oob.
MB_OAUTH_CLIENT_ID=
MB_OAUTH_CLIENT_SECRET=

# The address you reach this web UI at. Used for the downloadable userscript.
PUBLIC_URL=http://localhost:8097

# --- Optional integrations ------------------------------------------------------
# Everything below can also be entered in the web UI (header -> Settings).

# MusicBrainz Picard: folder inside this container where Picard's pipe appears
# (see compose.yaml) and where you reach Picard's own UI.
# PICARD_PIPE_DIR=/picard-run
# PICARD_URL=http://picard.local:5800
# The library's path as *Picard* sees it, if it differs from /music here:
# PICARD_LIBRARY_ROOT=/music
# Where Picard saves files (as seen here). Lets batch mode confirm they arrived:
# PICARD_DEST_ROOT=/music/Clean

# fanart.tv key for "Find online..." cover art.
# FANART_API_KEY=

# Lidarr: hand finished albums over by exact MusicBrainz release.
# LIDARR_URL=http://lidarr.local:8686
# LIDARR_API_KEY=
# The root folder as Lidarr sees it, and where Lidarr mounts the same library:
# LIDARR_ROOT_FOLDER=/data/Clean
# LIDARR_LIBRARY_PATH=/data
# LIDARR_AUTO=1            # batch mode sends each finished album automatically

# Music Genre Enforcer: review new artists' genres without leaving the app.
# ENFORCER_URL=http://enforcer.local:8320
# ENFORCER_AUTO=1          # batch mode tells it about each finished album
