# Copy this file to .env and fill in your details.
#
# MusicBrainz requires every API client to send a descriptive User-Agent
# with real contact info: "APP_NAME/APP_VERSION ( CONTACT )". These three
# values build that header. There is no separate "API key".
MB_APP_NAME=FilesToMB
MB_APP_VERSION=0.1.0
MB_CONTACT=you@example.com

# Override only if you want to point at a different MusicBrainz-compatible
# server, e.g. the beta test server.
MB_API_BASE_URL=https://musicbrainz.org/ws/2
